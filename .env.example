# Master switches
BOT_ENABLED=false
DRY_RUN=true
LOG_CONTENT=false

# Polling (used by main.py / Render)
POLL_INTERVAL_SECONDS=120

# Gmail
EMAIL_USER=youraddress@gmail.com
EMAIL_APP_PASSWORD=your_16_character_google_app_password
EMAIL_FROM_NAME=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SENT_FOLDER=

# REQUIRED safety cutoff. Set this to the current UTC time just before enabling.
IGNORE_BEFORE_UTC=2026-07-27T21:30:00Z

# Narrow the bot to one conversation. At least one must be set; both is safer.
TARGET_SUBJECT_CONTAINS=MSI Raider GE78HX
TARGET_EMAIL_CONTAINS=

# Context / memory
# CASE_CONTEXT.md contains the pre-bot case history, listing/address research and style samples.
CASE_CONTEXT_PATH=CASE_CONTEXT.md
# Optional private notes. On a public repo, put this in a GitHub Secret rather than committing it.
CASE_CONTEXT_EXTRA=

# Limits
MAX_REPLIES_PER_DAY=12
MAX_TOTAL_REPLIES=30
# The live Gmail thread is appended automatically on every run. 80 covers the expected full exchange.
MAX_CONTEXT_MESSAGES=80
MAX_BODY_CHARS=5000

# AI providers: tried in this order. Use one or both.
AI_PROVIDER_ORDER=gemini,groq

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.8

# Stop automatically if the latest incoming message contains one of these phrases.
# Comma-separated, case-insensitive.
STOP_PHRASES=do not contact me,don't contact me,dont contact me,stop emailing me,leave me alone,ne me contactez plus,ne me contacte plus,arrêtez de me contacter,arretez de me contacter,arrête de me contacter,arrete de me contacter
